# Secrets / local config -- keep only .env.example tracked
*.env
!.env.example

# Reports produced by the scripts (default location + any stray copies)
reports/
*.csv
*.html
# ...but the test fixtures are checked in.
!tests/**/*.csv
!tests/**/*.html

# Sonarr per-series cache written by find-missing-italian-audio.sh
*.cache.json

# Local Python virtual environment (created under verify/venv)
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
node_modules/

# Leftover temp sample dirs, if TEMP_DIR points into the repo
lang-check-*/

# OS cruft
.DS_Store
Thumbs.db
