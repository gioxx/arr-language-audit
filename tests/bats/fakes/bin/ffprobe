#!/usr/bin/env bash
# Fake ffprobe: report a scripted duration for the file it is asked about and,
# when the caller asks for streams, a scripted list of streams.
# The real invocation puts the media path last, so that is what we key on.
#
#   FAKE_DURATIONS   JSON map "<path>": <seconds>; anything not listed gets 600.
#   FAKE_STREAMS     JSON array of stream objects, e.g.
#                      [{"index":1,"codec_type":"audio","disposition":{"default":0}},
#                       {"index":2,"codec_type":"audio","disposition":{"default":1}}]
#                    Default: one default-disposition audio stream. With
#                    -select_streams a, non-audio streams are filtered out
#                    exactly as the real ffprobe would.
#   FAKE_FFPROBE_LOG file to append argv to, one invocation per line.
#
# Each section is printed ONLY when the caller asked for it -- "format" for
# -show_format or -show_entries format=..., "streams" for -show_streams or
# -show_entries ...stream=... -- because a permissive shim answers a caller
# that forgot a flag, and then no test can notice the flag going missing.
set -u

input=""
prev=""
want_format=0
want_streams=0
audio_only=0
for arg in "$@"; do
    case "$arg" in
        -show_format) want_format=1 ;;
        -show_streams) want_streams=1 ;;
    esac
    if [[ "$prev" == "-show_entries" ]]; then
        case "$arg" in
            *format=*) want_format=1 ;;
        esac
        case "$arg" in
            *stream=*|*stream_disposition=*) want_streams=1 ;;
        esac
    fi
    if [[ "$prev" == "-select_streams" && "$arg" == a* ]]; then
        audio_only=1
    fi
    input="$arg"
    prev="$arg"
done

if [[ -n "${FAKE_FFPROBE_LOG:-}" ]]; then
    printf '%s\n' "$*" >> "$FAKE_FFPROBE_LOG"
fi

duration=600
if [[ -n "${FAKE_DURATIONS:-}" ]]; then
    scripted=$(printf '%s' "$FAKE_DURATIONS" \
        | "${REAL_JQ:-jq}" -r --arg p "$input" '.[$p] // empty' 2>/dev/null)
    if [[ -n "$scripted" ]]; then
        duration="$scripted"
    fi
fi

if (( want_streams == 0 )); then
    if (( want_format == 1 )); then
        printf '{"format":{"duration":"%s"}}\n' "$duration"
    else
        # Real ffprobe asked for nothing prints an empty object.
        printf '{}\n'
    fi
    exit 0
fi

default_streams='[{"index":0,"codec_type":"audio","disposition":{"default":1}}]'
printf '%s' "${FAKE_STREAMS:-$default_streams}" \
    | "${REAL_JQ:-jq}" -c --arg d "$duration" \
        --argjson want_format "$want_format" --argjson audio_only "$audio_only" \
        'if $audio_only == 1
         then map(select((.codec_type // "audio") == "audio"))
         else . end
         | {streams: .} as $streams
         | (if $want_format == 1 then {format: {duration: $d}} else {} end)
           + $streams'
