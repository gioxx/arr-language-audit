# arr-language-audit -- phase 1 configuration.
#
# Copy this file to .env in the repo root and fill in your real values:
#
#     cp .env.example .env
#
# Format: KEY=value, one per line, no quotes, no spaces around '='.
# .env is git-ignored. Only this .env.example is committed.
#
# You can skip creating this file: on the first interactive run,
# scan/find-missing-italian-audio.sh starts a wizard that auto-detects a
# local Radarr/Sonarr via the unauthenticated /ping endpoint and offers to
# write the .env for you.

# --- Radarr (movies) ---
RADARR_URL=http://localhost:7878
RADARR_API_KEY=YOUR_RADARR_API_KEY
# Set to true to skip Radarr entirely.
SKIP_RADARR=false

# --- Sonarr (TV) ---
SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_SONARR_API_KEY
# Set to true to skip Sonarr entirely.
SKIP_SONARR=false

# --- Optional: force a disk rescan before reading mediaInfo ---
# When true, phase 1 first runs RescanMovie / RescanSeries so Radarr/Sonarr
# re-read every file from disk. Fixes stale/cached language tags, but is
# slower on large libraries.
FORCE_RESCAN=false
# Seconds to wait for a rescan command to finish before giving up. A rescan
# that reports failed, aborted, cancelled or orphaned is not waited out.
RESCAN_TIMEOUT=900
# Seconds between two rescan status polls.
RESCAN_POLL_INTERVAL=5

# --- Optional: Sonarr per-series cache ---
# Sonarr is fetched once per series and a <output>.cache.json file lets
# unchanged series be skipped next run. Set REFRESH=true (or pass --refresh)
# to ignore that cache and re-fetch everything.
REFRESH=false
