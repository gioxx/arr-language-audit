# arr-language-audit -- configuration template.
#
# Copy this file to .env in the repo root and fill in your real values:
#
#     cp .env.example .env
#
# Lookup: <repo>/.env, then <repo>/scan/.env -- first match wins. The current
# working directory is deliberately NOT searched. ALA_DOTENV_FILE, when set,
# replaces that search with the file it names.
#
# Precedence: a command-line flag beats an already-set, non-empty environment
# variable, which beats this file, which beats the built-in defaults.
#
# Format: KEY=value, one per line, no spaces around '='. Blank lines and #
# comments are skipped. This file is PARSED, never sourced or eval'd, so
# values are NOT shell-expanded: $HOME, $(...) and backquotes stay literal
# text. One pair of surrounding quotes is stripped and nothing else is
# interpreted. Keys outside the allow-list are reported and ignored.
#
# .env is git-ignored. Only this .env.example is committed.
#
# You can skip creating this file: on the first interactive run,
# scan/find-missing-italian-audio.sh starts a wizard that auto-detects a
# local Radarr/Sonarr via the unauthenticated /ping endpoint and offers to
# write the .env for you.

# ===========================================================================
# Phase 1 -- scan/find-missing-italian-audio.sh
# ===========================================================================

# --- Radarr (movies) ---
RADARR_URL=http://localhost:7878
RADARR_API_KEY=YOUR_RADARR_API_KEY
# Set to true to skip Radarr entirely.
SKIP_RADARR=false

# --- Sonarr (TV) ---
SONARR_URL=http://localhost:8989
SONARR_API_KEY=YOUR_SONARR_API_KEY
# Set to true to skip Sonarr entirely.
SKIP_SONARR=false

# --- Optional: force a disk rescan before reading mediaInfo ---
# When true, phase 1 first runs RescanMovie / RescanSeries so Radarr/Sonarr
# re-read every file from disk. Fixes stale/cached language tags, but is
# slower on large libraries. Implies REFRESH=true.
FORCE_RESCAN=false
# Seconds to wait for a rescan command to finish before giving up. A rescan
# that reports failed, aborted, cancelled or orphaned is not waited out.
RESCAN_TIMEOUT=900
# Seconds between two rescan status polls.
RESCAN_POLL_INTERVAL=5

# --- Optional: Sonarr per-series cache ---
# Sonarr is fetched once per series and a <output>.cache.json file lets
# unchanged series be skipped next run. Set REFRESH=true (or pass --refresh)
# to ignore that cache and re-fetch everything.
REFRESH=false

# ===========================================================================
# Phase 2 -- verify/verify-audio-language.sh (all optional)
# ===========================================================================

# Interpreter to run phase 2 with. One that cannot import faster_whisper is
# reported and ignored; the search then falls back to verify/venv, then to
# the system python3.
#PYTHON_BIN=/usr/local/bin/python3

# tiny | base | small | medium -- bigger is more accurate and slower.
#WHISPER_MODEL=small
# CPU threads for the model. Defaults to every core.
#WHISPER_THREADS=4

# Audio sample length, in seconds, and where in the file to start sampling
# (as a percentage of total duration -- 25 skips most intros).
#SAMPLE_SECONDS=60
#SAMPLE_OFFSET_PCT=25

# 0..1. A detection whose probability is below this is written out as
# LOW_CONFIDENCE instead of as a verdict.
#MIN_CONFIDENCE=0.6

# Minimum free space, in MB, required for the temporary audio samples.
#MIN_FREE_SPACE_MB=500
# PARENT directory for the samples: the run creates its own private
# lang-check-* directory inside it and removes only that one. The directory
# named here is never deleted. Defaults to the system temp directory.
#TEMP_DIR=/var/tmp

# Only (re)verify the first N files that need it (useful for a test run).
#LIMIT=10
# true to also reprocess retryable rows (FILE_NOT_FOUND, EXTRACTION_FAILED,
# DETECTION_FAILED, LOW_CONFIDENCE).
#RETRY_ERRORS=false
# true to ignore an existing output CSV and start fresh.
#NO_RESUME=false
